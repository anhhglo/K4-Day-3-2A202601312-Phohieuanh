# =============================================================================
# ⚙️ CẤU HÌNH LLM — copy file này thành `.env` rồi điền key
#
#     cp .env.example .env
#
# Không có key vẫn chạy demo được ở chế độ giả lập:
#     python src/web_demo.py --mock
# =============================================================================

# -----------------------------------------------------------------------------
# 📌 BƯỚC 1: CHỌN ĐƯỜNG GỌI LLM
#
#   openai  — endpoint OpenAI-compatible. ĐÂY LÀ CẤU HÌNH NHÓM ĐANG DÙNG, vì
#             Gemini có endpoint OpenAI-compat miễn phí (xem BƯỚC 3).
#   gemini  — API native của Google, cần GEMINI_API_KEY riêng
#   groq    — Groq, cần GROQ_API_KEY
#   mock    — không gọi mạng, trả lời giả lập. Dùng để tập demo.
#
# ⚠️ Giá trị này PHẢI khớp với key bạn điền ở BƯỚC 2. Đặt `openai` mà chỉ có
#    GEMINI_API_KEY là cấu hình chết — chạy sẽ báo thiếu key.
#    Chạy `python src/pre_demo_check.py` để nó kiểm hộ.
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai

# -----------------------------------------------------------------------------
# 📌 BƯỚC 2: API KEY
#
# Lấy key Gemini miễn phí tại https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
OPENAI_API_KEY=dan_key_cua_ban_vao_day

# 🔑 GÓP NHIỀU KEY ĐỂ THOÁT TRẦN QUOTA
#
# Free tier Gemini cho 20 request/ngày/model/project. Một lần chạy đủ 7 test case
# là hết. Bốn thành viên góp bốn key thì thành 80 request/ngày.
#
# Hệ thống tự xoay sang key kế tiếp khi key hiện tại hết quota. Dùng được cả hai
# dạng dưới đây cùng lúc; key trùng nhau sẽ tự khử.
# OPENAI_API_KEY_2=key_cua_ban_thu_hai
# OPENAI_API_KEY_3=key_cua_ban_thu_ba
# OPENAI_API_KEY_4=key_cua_ban_thu_tu
# OPENAI_API_KEYS=key_a,key_b,key_c

# Chỉ cần khi LLM_PROVIDER=gemini hoặc groq
# GEMINI_API_KEY=
# GROQ_API_KEY=

# -----------------------------------------------------------------------------
# 📌 BƯỚC 3: ENDPOINT
#
# Dòng dưới trỏ vào lớp tương thích OpenAI của Google — nhờ nó, key Gemini miễn
# phí dùng được qua giao thức OpenAI. Bỏ dòng này thì sẽ gọi thẳng api.openai.com
# (cần key OpenAI trả phí).
# -----------------------------------------------------------------------------
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# -----------------------------------------------------------------------------
# 📌 BƯỚC 4: MODEL
#
# Hạn mức tính RIÊNG cho từng model, nên khai báo model phụ là có thêm một hạn
# mức nữa. Model chính cạn thì hệ thống tự chuyển sang model phụ.
#
# Xem tên model hiện có tại https://aistudio.google.com
# -----------------------------------------------------------------------------
LLM_MODEL=gemini-3.5-flash
LAB_MODEL=gemini-3.5-flash
LAB_MINI_MODEL=gemini-3.5-flash-lite
